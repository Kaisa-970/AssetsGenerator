+"""Content-based deployment declaration, computed once before accepting requests."""
+import importlib.metadata
+import platform
+from pathlib import Path
+
+from api_protocol import digest, file_descriptor
+
+
+def tree(root, suffixes=None):
+    root = Path(root)
+    values = {}
+    if root.is_dir():
+        for path in sorted(root.rglob('*')):
+            if path.is_file() and '__pycache__' not in path.parts and (suffixes is None or path.suffix in suffixes):
+                values[path.relative_to(root).as_posix()] = file_descriptor(path)
+    return values
+
+
+def build_identity(project, models=Path('/models')):
+    project, models = Path(project), Path(models)
+    source = {}
+    for name in ('api_server.py', 'api_protocol.py', 'api_identity.py', 'web_app.py',
+                 'quality_options.py', 'texture_baking.py', 'sam2_client.py', 'sam2_worker.py'):
+        source[name] = file_descriptor(project / name)
+    for folder in ('sam3d_objects', 'notebook'):
+        source.update({folder+'/'+name: item for name,item in tree(project/folder, {'.py','.yaml','.json'}).items()})
+    checkpoints = tree(models/'checkpoints')
+    # Auxiliary depth/image encoders can be loaded from HF/Torch caches. Capture
+    # actual cached blobs too; do not label only SAM3D checkpoint files complete.
+    auxiliary = {}
+    for folder in ('huggingface/hub', 'torch/hub/checkpoints'):
+        for name, item in tree(project/'.cache'/folder).items():
+            if '/.locks/' not in '/'+name and not name.endswith('.lock'):
+                auxiliary[folder+'/'+name] = item
+    packages = {name: importlib.metadata.version(name) for name in
+                ('torch','torchvision','numpy','Pillow','trimesh','gradio','fastapi')}
+    body = {'schema':'sam3d-deployment@1', 'source_digest':digest(source),
+            'checkpoint_digest':digest(checkpoints), 'auxiliary_cache_digest':digest(auxiliary),
+            'sam2_digest':digest(tree(models/'sam2')), 'packages':packages,
+            'python':platform.python_version(), 'verification':'startup_content_hashes',
+            'environment_verification':'package_versions_only',
+            'mutable_resources_policy':'restart required after changing code or model files',
+            'spatial':{'frame_id':'sam3d_glb', 'handedness':'right', 'up_axis':'+Y',
+                       'forward_axis':None, 'unit':'relative', 'metric_scale_verified':False,
+                       'mesh_row_vector_transform':[[1,0,0],[0,0,-1],[0,1,0]],
+                       'basis':'export code converts model Z-up to GLB Y-up; semantic front unverified'}}
+    return {**body, 'backend_digest':digest(body), 'checkpoint_files':checkpoints}
