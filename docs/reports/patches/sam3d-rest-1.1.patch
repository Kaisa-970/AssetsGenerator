+"""Durable API submission identities; independent of GPU and web frameworks."""
+import hashlib
+import json
+import os
+import re
+import sqlite3
+import uuid
+from pathlib import Path
+
+
+class SubmissionConflict(ValueError):
+    pass
+
+
+def canonical(value):
+    return json.dumps(value, sort_keys=True, separators=(',', ':'), ensure_ascii=True,
+                      allow_nan=False).encode()
+
+
+def digest(value):
+    return 'sha256:' + hashlib.sha256(canonical(value)).hexdigest()
+
+
+def file_descriptor(path):
+    h = hashlib.sha256()
+    size = 0
+    with Path(path).open('rb') as stream:
+        while chunk := stream.read(1024 * 1024):
+            h.update(chunk)
+            size += len(chunk)
+    return {'sha256': 'sha256:' + h.hexdigest(), 'byte_length': size}
+
+
+def atomic_json(path, value):
+    path = Path(path)
+    tmp = path.with_name(path.name + '.tmp')
+    with tmp.open('wb') as stream:
+        stream.write(canonical(value))
+        stream.flush()
+        os.fsync(stream.fileno())
+    os.replace(tmp, path)
+    sync_directory(path.parent)
+
+
+def sync_directory(path):
+    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
+    try:
+        os.fsync(fd)
+    finally:
+        os.close(fd)
+
+
+def request_identity(image, mask, points, options):
+    return {'schema': 'sam3d-request@1', 'image': file_descriptor(image)['sha256'],
+            'mask': file_descriptor(mask)['sha256'] if mask else None,
+            'points': points, 'options': options}
+
+
+def validate_key(key, request_digest):
+    if not isinstance(key, str) or not re.fullmatch(r'[A-Za-z0-9_-]{1,128}', key):
+        raise ValueError('submission_key must contain 1..128 letters, digits, underscores or hyphens')
+    if not isinstance(request_digest, str) or not re.fullmatch(r'sha256:[0-9a-f]{64}', request_digest):
+        raise ValueError('invalid request_digest')
+
+
+class SubmissionRegistry:
+    """Permanent key tombstones outlive expiring job output directories.
+
+    A registry identity sidecar prevents recreating a missing database. Service
+    serializes reserve+queue operations; SQLite enforces concurrent key identity.
+    """
+    def __init__(self, path):
+        self.path = Path(path)
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        marker = self.path.with_suffix('.identity.json')
+        fresh = not self.path.exists() and not marker.exists()
+        if not fresh and (not self.path.is_file() or not marker.is_file()):
+            raise RuntimeError('submission registry missing; refusing to recreate')
+        if fresh:
+            atomic_json(marker, {'schema': 'sam3d-submissions@1', 'id':uuid.uuid4().hex})
+        identity = json.loads(marker.read_bytes())
+        if set(identity) != {'schema','id'} or identity['schema'] != 'sam3d-submissions@1':
+            raise RuntimeError('invalid submission registry marker')
+        if fresh:
+            with self.path.open("xb") as stream:
+                stream.flush()
+                os.fsync(stream.fileno())
+        with self.connect() as db:
+            if fresh:
+                db.execute('CREATE TABLE identity (body BLOB NOT NULL)')
+                db.execute('INSERT INTO identity VALUES (?)', (canonical(identity),))
+                db.execute('CREATE TABLE submissions (key TEXT PRIMARY KEY, digest TEXT NOT NULL, '
+                           'job_id TEXT NOT NULL UNIQUE, receipt BLOB NOT NULL)')
+            else:
+                if db.execute('SELECT body FROM identity').fetchall() != [(canonical(identity),)]:
+                    raise RuntimeError('submission registry identity mismatch')
+                db.execute('SELECT key,digest,job_id,receipt FROM submissions LIMIT 0')
+        sync_directory(self.path.parent)
+
+    def connect(self):
+        db = sqlite3.connect(self.path.as_uri() + "?mode=rw", uri=True, timeout=30)
+        db.execute('PRAGMA synchronous=FULL')
+        return db
+
+    def lookup(self, key):
+        if not isinstance(key, str) or not re.fullmatch(r'[A-Za-z0-9_-]{1,128}', key):
+            raise ValueError('invalid submission key')
+        with self.connect() as db:
+            row = db.execute('SELECT receipt FROM submissions WHERE key=?', (key,)).fetchone()
+        return None if row is None else json.loads(row[0])
+
+    def reserve(self, key, request_digest, job_id, backend_digest):
+        validate_key(key, request_digest)
+        receipt = {'id': job_id, 'submission_key': key, 'request_digest': request_digest,
+                   'backend_digest': backend_digest, 'status_url': f'/api/v1/jobs/{job_id}'}
+        with self.connect() as db:
+            db.execute('BEGIN IMMEDIATE')
+            row = db.execute('SELECT receipt FROM submissions WHERE key=?', (key,)).fetchone()
+            if row:
+                old = json.loads(row[0])
+                if old['request_digest'] != request_digest or old['backend_digest'] != backend_digest:
+                    raise SubmissionConflict('submission key already belongs to another request or deployment')
+                return old, False
+            db.execute('INSERT INTO submissions VALUES (?,?,?,?)',
+                       (key, request_digest, job_id, canonical(receipt)))
+        return receipt, True
